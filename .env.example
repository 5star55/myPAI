# Copy this file to .env and edit it. .env is git-ignored: never commit real keys.

# mock = scripted replies, no API needed.  live = call a real OpenAI-compatible server.
MODEL_MODE=mock

# --- Option A: Ollama on your PC (default for live mode) ---
# Install Ollama, then run: ollama pull llama3.1:8b
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
SMALL_MODEL=llama3.1:8b
BIG_MODEL=llama3.1:8b

# --- Option B: Nebius Token Factory (NVIDIA Nemotron) ---
# Only these four lines change. Get the exact model IDs your key can use with:
#   curl -s https://api.tokenfactory.nebius.com/v1/models -H "Authorization: Bearer $KEY" | grep -io '"id":"[^"]*nemotron[^"]*"'
# Suggested: a small Nemotron Nano for chat, a Nemotron Super for tool calling.
# MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# MODEL_API_KEY=your-nebius-key-here
# SMALL_MODEL=<nemotron nano id from the list>
# BIG_MODEL=<nemotron super id from the list>

# Max tokens per reply (applied to every request).
SMALL_MAX_TOKENS=512
BIG_MAX_TOKENS=1024

# Step 7 (optional): web search
# TAVILY_API_KEY=

# Optional: store pai's data (profile, memory, log) in another folder, e.g. for testing.
# PAI_DATA_DIR=/tmp/pai-test-data
