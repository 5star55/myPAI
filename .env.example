# Copy this file to .env and edit it. .env is git-ignored: never commit real keys.

# mock = scripted replies, no API needed.  live = call a real OpenAI-compatible server.
MODEL_MODE=live

# --- Option A: Nebius Token Factory (NVIDIA Nemotron) ---
# List the model IDs your key can use with:
#   curl -s https://api.tokenfactory.nebius.com/v1/models -H "Authorization: Bearer $KEY" | grep -io '"id":"[^"]*nemotron[^"]*"'
# A Nemotron Nano for chat, a Nemotron Super for tool calling, a Nemotron VL to see pictures.
MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_API_KEY=your-nebius-key-here
SMALL_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
BIG_MODEL=nvidia/nemotron-3-super-120b-a12b
# Looks at pictures you attach and describes them for BIG_MODEL. Empty = BIG_MODEL is tried.
VISION_MODEL=nvidia/Nemotron-3.5-Super-VL

# --- Option B: Ollama on your PC (free, runs locally) ---
# To use it instead, comment out Option A and uncomment these. Install Ollama, then run: ollama pull llama3.1:8b
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_API_KEY=ollama
# SMALL_MODEL=llama3.1:8b
# BIG_MODEL=llama3.1:8b
# VISION_MODEL=llama3.2-vision   (ollama pull llama3.2-vision)

# Max tokens per reply (applied to every request). Cut-off replies are continued automatically.
# BIG_MAX_TOKENS must fit a whole source file in one tool call (coding). With Ollama, 1536 is enough.
# SMALL_MAX_TOKENS fits a 10-question quiz in one reply. With Ollama, 1024 is enough.
SMALL_MAX_TOKENS=4096
BIG_MAX_TOKENS=8192

# How much the model reads at once (system prompt + tools + history + reply).
# Hosted models: 65536 leaves room for source files and long coding sessions.
# With Ollama, pai creates "<model>-pai" with this context size (Ollama's default is ~2k
# tokens and it silently drops the start of longer prompts). Use 8192 for 8B models, or more
# (e.g. 16384) if you have the memory.
MODEL_CONTEXT_TOKENS=65536

# Step 7 (optional): web search
# TAVILY_API_KEY=

# Optional: store pai's data (profile, memory, log) in another folder, e.g. for testing.
# PAI_DATA_DIR=/tmp/pai-test-data
