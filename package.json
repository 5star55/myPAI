{
  "name": "pai",
  "productName": "pai",
  "version": "0.1.0",
  "description": "A private personal AI assistant that runs on your PC, remembers you, and asks permission before acting.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "prestart": "node scripts/build-native.mjs",
    "start": "electron-vite preview",
    "predev": "node scripts/build-native.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/build-native.mjs",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "dotenv": "^18.0.8",
    "get-windows": "^9.3.0",
    "kokoro-js": "^1.2.1",
    "openai": "^7.38.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
